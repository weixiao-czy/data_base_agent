# ============================================================
# 环境变量配置示例
# 复制本文件为 .env 并填入真实值（.env 已在 .gitignore 中）
# ============================================================

# ------------------------------------------------------------
# LLM 配置（OpenAI 兼容接口）
# 默认使用上海交大免费 API，也可替换为其他兼容服务
# ------------------------------------------------------------
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://models.sjtu.edu.cn/api/v1
OPENAI_MODEL=deepseek-reasoner

# ------------------------------------------------------------
# SciMaster 文献检索配置（可选）
# 未配置时自动降级为 Crossref + arXiv（免费、无需 Key）
# 注册：https://www.scimaster.cn
# ------------------------------------------------------------
SCIMASTER_API_KEY=your-scimaster-api-key-here
SCIMASTER_BASE_URL=https://api.scimaster.cn

# ------------------------------------------------------------
# 检索通用配置
# ------------------------------------------------------------
SEARCH_DEFAULT_LIMIT=10
SEARCH_TIMEOUT=30
